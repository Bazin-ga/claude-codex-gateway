[Unit]
Description=Keep the Codex credential fresh
Documentation=https://github.com/Bazin-ga/claude-codex-gateway

[Timer]
# Twice daily against a ~10-day token renewed below 4 days remaining: many
# chances to succeed before anything breaks.
OnCalendar=*-*-* 06,18:00:00
RandomizedDelaySec=1h
# Catch up after the machine was off at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
