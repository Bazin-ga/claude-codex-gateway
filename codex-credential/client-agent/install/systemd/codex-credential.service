[Unit]
Description=Pull a fresh Codex credential
Documentation=https://github.com/Bazin-ga/claude-codex-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Credentials live in a mode-600 env file rather than inline here, so reading the
# unit does not disclose this machine's bearer token.
EnvironmentFile=%h/.config/codex-credential.env
ExecStart=NODE_PATH AGENT_PATH
