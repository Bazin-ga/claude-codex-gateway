<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd agent. install.sh substitutes the placeholders and loads it;
  it is not meant to be edited by hand.

  It runs run.sh rather than node directly: launchd has no EnvironmentFile
  equivalent, and inlining the bearer token here would put it in a
  world-readable plist. run.sh sources the mode-600 env file instead.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claude-codex-gateway.codex-credential</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>RUNNER_PATH</string>
  </array>
  <!-- Twice daily; RunAtLoad covers a laptop that was closed at the scheduled time. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>LOG_PATH</string>
  <key>StandardErrorPath</key>
  <string>LOG_PATH</string>
</dict>
</plist>
