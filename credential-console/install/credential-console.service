[Unit]
Description=Claude and Codex credential console and Claude gateway
Documentation=https://github.com/Bazin-ga/claude-codex-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=credential-console
Group=credential-console
SupplementaryGroups=codex-credential
WorkingDirectory=/opt/claude-codex-gateway/credential-console
Environment=CREDENTIAL_CONSOLE_HOME=/var/lib/credential-console
Environment=CREDENTIAL_CONSOLE_BIND=127.0.0.1
Environment=CREDENTIAL_CONSOLE_PORT=9080
Environment=NODE_OPTIONS=--max-old-space-size=96
EnvironmentFile=-/etc/credential-console.env
ExecStart=/usr/bin/node /opt/claude-codex-gateway/credential-console/server.js
Restart=always
RestartSec=5
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=160M
# Read-only import: the console reads the Codex credential's health, never its
# refresh token. CREDENTIAL_CONSOLE_CODEX_SEED_HOME needs these three lines
# relaxed in a drop-in as well — an ACL cannot reopen a mount namespace. See
# DEPLOY.md, "the console seeds the home directly".
ReadWritePaths=/var/lib/credential-console
ReadOnlyPaths=/var/lib/codex-credential/public
InaccessiblePaths=/var/lib/codex-credential/secret /var/lib/codex-credential/clients

[Install]
WantedBy=multi-user.target
